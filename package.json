{
  "name": "chirographe-protocol",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "brand": "node brand/build.mjs",
    "guardian": "pnpm --filter @chirographe/server-app guardian",
    "guardian:rotate": "pnpm --filter @chirographe/server-app guardian:rotate",
    "witness": "pnpm --filter @chirographe/server-app witness"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@playwright/test": "^1.64.0",
    "@types/node": "^24.0.0",
    "eslint": "^9.0.0",
    "prettier": "^3.0.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.0.0"
  }
}
