# Guardian (pnpm guardian)
GUARDIAN_NAME="Guardian X"
GUARDIAN_URL=https://guardian.example.com
GUARDIAN_PASSWORD=change-me
# GUARDIAN_ISSUERS=p256:...           # keys allowed in the issuer of a new token here, anyone by default
